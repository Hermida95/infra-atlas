{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "description": "Real code in this repo that proves the concept. `lines` is 1-based and inclusive.",
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "lines": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "minimum": 1,
              "type": "integer"
            }
          ],
          "title": "Lines",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "path",
        "lines",
        "text"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Part": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "os",
                "pkg",
                "code",
                "meta",
                "rw",
                "node",
                "pod",
                "bus",
                "orbit",
                "core",
                "machine",
                "cylinder",
                "discs",
                "sheet",
                "plugin",
                "modules",
                "graph",
                "trigger",
                "jobs",
                "chips",
                "gate",
                "lanes",
                "split",
                "loop",
                "disc",
                "zones",
                "vpc",
                "services",
                "shell",
                "ring",
                "bars",
                "bell",
                "panel",
                "sphere",
                "satellites"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "name",
        "text"
      ],
      "title": "Part",
      "type": "object"
    },
    "Planner": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "build",
            "containerize",
            "infra",
            "run",
            "data",
            "secure",
            "ship",
            "deliver",
            "observe"
          ],
          "title": "Stage",
          "type": "string"
        },
        "when": {
          "minLength": 1,
          "title": "When",
          "type": "string"
        },
        "why": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Why",
          "type": "string"
        },
        "notes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlannerNote"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "stage",
        "when",
        "why"
      ],
      "title": "Planner",
      "type": "object"
    },
    "PlannerNote": {
      "additionalProperties": false,
      "properties": {
        "when": {
          "minLength": 1,
          "title": "When",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "when",
        "text"
      ],
      "title": "PlannerNote",
      "type": "object"
    },
    "Relations": {
      "additionalProperties": false,
      "properties": {
        "related": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Related",
          "type": "array"
        },
        "requires": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        },
        "part_of": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Part Of",
          "type": "array"
        },
        "alternative_to": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Alternative To",
          "type": "array"
        },
        "used_by": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "title": "Used By",
          "type": "array"
        }
      },
      "title": "Relations",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "type": {
      "enum": [
        "concept",
        "service",
        "tool",
        "pattern",
        "howto",
        "comparison",
        "lab"
      ],
      "title": "Type",
      "type": "string"
    },
    "domain": {
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "title": "Domain",
      "type": "string"
    },
    "hub": {
      "default": false,
      "title": "Hub",
      "type": "boolean"
    },
    "summary": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "logo": {
      "anyOf": [
        {
          "pattern": "^(aws:)?[a-z0-9]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logo"
    },
    "monogram": {
      "anyOf": [
        {
          "pattern": "^[A-Z0-9]{1,3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Monogram"
    },
    "level": {
      "default": "core",
      "enum": [
        "core",
        "intermediate",
        "advanced"
      ],
      "title": "Level",
      "type": "string"
    },
    "access": {
      "default": "free",
      "enum": [
        "free",
        "pro"
      ],
      "title": "Access",
      "type": "string"
    },
    "relations": {
      "$ref": "#/$defs/Relations",
      "default": {
        "related": [],
        "requires": [],
        "part_of": [],
        "alternative_to": [],
        "used_by": []
      }
    },
    "lead": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lead"
    },
    "parts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Part"
      },
      "title": "Parts",
      "type": "array"
    },
    "layout": {
      "default": "stack",
      "enum": [
        "stack",
        "row",
        "cluster"
      ],
      "title": "Layout",
      "type": "string"
    },
    "lab": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lab"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "reviewed": {
      "format": "date",
      "title": "Reviewed",
      "type": "string"
    },
    "planner": {
      "anyOf": [
        {
          "$ref": "#/$defs/Planner"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "domain",
    "summary",
    "reviewed"
  ],
  "title": "NodeFrontmatter",
  "type": "object"
}
