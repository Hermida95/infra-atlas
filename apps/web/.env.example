# Copy to .env.local. Both are inlined into the bundle at build time.

# FastAPI app (make api). When set, the ⌘K palette also searches by meaning through
# GET /search; when empty, it only runs the local keyword search.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of the site, used by sitemap.xml.
# NEXT_PUBLIC_SITE_URL=https://example.com
